# Every variable the app + prod compose file reference. This doubles as
# the disaster-recovery checklist for reconstructing /etc/xarxa/.env on a
# fresh box — keep it in sync when adding env vars.

# Database
DATABASE_URL="postgresql://xarxa:xarxa@localhost:5432/xarxa?schema=public"
# Prod compose builds DATABASE_URL from this instead:
POSTGRES_PASSWORD=""

# NextAuth
NEXTAUTH_SECRET="" # Generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000" # prod: https://xarxa.help (no trailing slash)

# Email (Resend) — optional in dev: sends are skipped with a console warning
RESEND_API_KEY="" # starts with re_
EMAIL_FROM="noreply@xarxa.help"
# Receives backup-failure, host-health, and post-report alerts
OPERATOR_EMAIL=""

# Sentry — optional
SENTRY_DSN=""
SENTRY_AUTH_TOKEN="" # build-time only, for source-map upload

# Google OAuth (optional, provider currently disabled)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
