generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  PRIVATE
  COLLECTIVE
}

enum PostType {
  OFFER
  REQUEST
}

enum Category {
  LEGAL
  EDUCATION
  HEALTH
  TECHNOLOGY
  MANUAL_WORK
  TRANSLATION
  OTHER
}

enum Urgency {
  LOW
  NORMAL
  URGENT
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ReportReason {
  HATE_SPEECH
  HARASSMENT
  SPAM
  INAPPROPRIATE
  OTHER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  password     String?
  name         String
  surname      String?
  type         UserType  @default(PRIVATE)
  location     String?
  bio          String?
  skills       String[]
  mission      String?
  profilePhoto      String?
  preferredLanguage String?
  languages         String[]
  emailVerified     DateTime?
  // Set on every password reset/change; JWTs issued before this moment
  // are rejected in the jwt callback (invalidates stolen sessions on
  // account recovery).
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  posts         Post[]
  connections   Connection[]    @relation("requester")
  messages      Message[]
  conversations Conversation[]  @relation("ConversationParticipants")
  reports       Report[]        @relation("reporter")
  passwordResetTokens PasswordResetToken[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

model PasswordResetToken {
  token   String   @id
  userId  String
  expires DateTime
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model Post {
  id           String   @id @default(cuid())
  title        String
  type         PostType
  category     Category
  description  String
  urgency      Urgency  @default(NORMAL)
  availability String?
  location     String?
  isRemote     Boolean  @default(false)
  tags         String[]
  closed       Boolean  @default(false)
  // When the "your post will close soon — still active?" nudge email was
  // sent. Cleared implicitly by comparing against updatedAt: any edit or
  // reopen bumps updatedAt past it, re-arming the nudge for the next cycle.
  expiryNudgedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  connections Connection[]
  reports     Report[]

  @@index([createdAt])
  @@index([authorId])
  @@index([type])
  @@index([category])
  @@index([closed, createdAt])
}

model Report {
  id        String       @id @default(cuid())
  reason    ReportReason
  details   String?
  createdAt DateTime     @default(now())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  reporterId String
  reporter   User   @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([postId, reporterId])
  @@index([createdAt])
}

model Connection {
  id              String           @id @default(cuid())
  status          ConnectionStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  seenByRequester Boolean          @default(false)

  postId    String
  post      Post    @relation(fields: [postId], references: [id])

  requesterId String
  requester   User   @relation("requester", fields: [requesterId], references: [id])

  conversationId String?       @unique
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  @@unique([postId, requesterId])
  @@index([requesterId, status])
  @@index([status])
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  participants User[]      @relation("ConversationParticipants")
  messages     Message[]
  connection   Connection?
}

model Message {
  id        String   @id @default(cuid())
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId, read])
}
