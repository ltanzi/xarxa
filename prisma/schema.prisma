generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  PRIVATE
  COLLECTIVE
}

enum PostType {
  OFFER
  REQUEST
}

// Order here is cosmetic; src/lib/categories.ts owns the order the UI shows.
enum Category {
  MANUAL_WORK
  MOVING
  GARDENING
  ANIMALS
  COOKING
  CARE
  HEALTH
  EDUCATION
  LANGUAGES
  PAPERWORK
  LEGAL
  TECHNOLOGY
  COMMUNICATION
  CREATIVE
  MUSIC
  EVENTS
  OTHER
}

enum Urgency {
  LOW
  NORMAL
  URGENT
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ReportReason {
  HATE_SPEECH
  HARASSMENT
  SPAM
  INAPPROPRIATE
  OTHER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  password     String?
  name         String
  surname      String?
  type         UserType  @default(PRIVATE)
  location     String?
  bio          String?
  mission      String?
  profilePhoto      String?
  preferredLanguage String?
  languages         String[]
  emailVerified     DateTime?
  // Set on every password reset/change; JWTs issued before this moment
  // are rejected in the jwt callback (invalidates stolen sessions on
  // account recovery).
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  posts         Post[]
  connections   Connection[]    @relation("requester")
  messages      Message[]
  conversations Conversation[]  @relation("ConversationParticipants")
  reports       Report[]        @relation("reporter")
  passwordResetTokens PasswordResetToken[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

model PasswordResetToken {
  token   String   @id
  userId  String
  expires DateTime
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model Post {
  id           String   @id @default(cuid())
  title        String
  type         PostType
  // A post is rarely one thing — "help me move a piano" is Moving and
  // Music. Capped at MAX_CATEGORIES_PER_POST in the Zod schema so a post
  // can't claim the whole board.
  categories   Category[]
  // Free text the author types when they pick OTHER. Kept deliberately
  // uncontrolled: reading what people actually write here is how a real
  // category earns its place in the Category enum later.
  categoryOther String?
  description  String
  urgency      Urgency  @default(NORMAL)
  availability String?
  // Optional, REQUEST posts only: a small thank-you the author offers for
  // the help. Never money — the framing in the form copy does that work,
  // and guideline 1 still says no money changes hands.
  gift         String?
  location     String?
  // Optional, and only offered when location is Barcelona: one of the 73
  // official barris (see src/lib/barcelona.ts). Enough geography to judge
  // "could I get there?", nowhere near an address.
  neighborhood String?
  isRemote     Boolean  @default(false)
  tags         String[]
  closed       Boolean  @default(false)
  // When the "your post will close soon — still active?" nudge email was
  // sent. Cleared implicitly by comparing against updatedAt: any edit or
  // reopen bumps updatedAt past it, re-arming the nudge for the next cycle.
  expiryNudgedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  connections Connection[]
  reports     Report[]

  @@index([createdAt])
  @@index([authorId])
  @@index([type])
  @@index([categories], type: Gin)
  @@index([closed, createdAt])
}

model Report {
  id        String       @id @default(cuid())
  reason    ReportReason
  details   String?
  createdAt DateTime     @default(now())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  reporterId String
  reporter   User   @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([postId, reporterId])
  @@index([createdAt])
}

model Connection {
  id              String           @id @default(cuid())
  status          ConnectionStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  seenByRequester Boolean          @default(false)

  postId    String
  post      Post    @relation(fields: [postId], references: [id])

  requesterId String
  requester   User   @relation("requester", fields: [requesterId], references: [id])

  conversationId String?       @unique
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  @@unique([postId, requesterId])
  @@index([requesterId, status])
  @@index([status])
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  participants User[]      @relation("ConversationParticipants")
  messages     Message[]
  connection   Connection?
}

model Message {
  id        String   @id @default(cuid())
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId, read])
}
